# Database Configuration (MySQL or MongoDB Atlas)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=loanwise

# MongoDB Atlas URI (Recommended for Cloud Deployments like Render)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/loanwise?retryWrites=true&w=majority

# Application Port
PORT=3000

# Authentication Secret
JWT_SECRET=loanwise_super_secret_jwt_key_2026

# Email Automation (Mock / Ethereal or SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_user@ethereal.email
SMTP_PASS=mock_pass
